---
import Listing from '../../../layouts/Listing.astro';
import { allStories } from '../../../lib/content';
import { listingSections, pageSize } from '../../../lib/listing';

export async function getStaticPaths() {
  return listingSections(await allStories()).flatMap((section) =>
    Array.from({ length: Math.max(0, Math.ceil(section.stories.length / pageSize) - 1) }, (_, index) => ({
      params: { section: section.base.slice(1, -1), number: String(index + 2) },
      props: { ...section, page: index + 2 },
    })),
  );
}
---
<Listing {...Astro.props} />
