---
import Base from '../layouts/Base.astro';
import StoryList from '../components/StoryList.astro';
import { allStories, dateKey, storyUrl } from '../lib/content';
const stories = await allStories();
const briefing = stories.find((story) => story.collection === 'daily');
const news = stories.filter((story) => story.collection === 'news');
---
<Base>
  <div class="edition">
    <h1>全球 AI 资讯<span lang="en">Global AI News</span></h1>
    {stories[0] && <time datetime={stories[0].data.published.toISOString()}>{dateKey(stories[0].data.published)} <span>北京时间</span></time>}
  </div>
  {briefing && <section class="feature" aria-labelledby="featured-title">
    <div class="feature-copy">
      <div class="feature-label">每日 AI 简报 <span lang="en">/ Daily Briefing</span></div>
      <h2 id="featured-title"><a href={storyUrl(briefing)}>{briefing.data.titleZh}<span lang="en">{briefing.data.titleEn}</span></a></h2>
      <p>{briefing.data.summaryZh}<span lang="en">{briefing.data.summaryEn}</span></p>
      <a class="feature-link" href={storyUrl(briefing)}>阅读简报 <span lang="en">Read briefing</span> ↗</a>
    </div>
  </section>}
  <section aria-labelledby="latest">
    <div class="section-heading"><h2 id="latest">最新资讯 <span lang="en">Latest News</span></h2><a href="/news/">全部资讯 ↗</a></div>
    <StoryList nested stories={news.slice(0, 8)} />
  </section>
</Base>
