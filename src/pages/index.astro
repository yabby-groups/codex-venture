---
import Base from '../layouts/Base.astro';
import StoryList from '../components/StoryList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { dateKey, storyUrl, allStories } from '../lib/content';
import { recommendations, onHome } from '../lib/editorial';
const stories = (await allStories()).filter(onHome);
const { lead, picks } = recommendations(stories);
const focus = picks.filter((story) => story !== lead);
const latest = stories[0] && dateKey(stories[0].data.published);
---
<Base>
  <header class="edition">
    <h1>发现与实践 AI<span lang="en">Discover and Use AI</span></h1>
    {latest && <div>最近发布 <span lang="en">Latest update</span> <time datetime={latest}>{latest} · UTC+8</time></div>}
  </header>
  {picks.length > 0 && <section class="lead-grid" aria-label="编辑精选 / Editor’s picks" data-editorial-recommendations>
    {lead && <article class="lead">
      <div class="kicker"><span>头条</span><span lang="en">Top story</span></div>
      <h2><a href={storyUrl(lead)}>{lead.data.titleZh}<span lang="en">{lead.data.titleEn}</span></a></h2>
      <p>{lead.data.summaryZh}<span lang="en">{lead.data.summaryEn}</span></p>
      <a class="read-link" href={storyUrl(lead)}>阅读全文 <span lang="en">Read story ↗</span></a>
    </article>}
    {focus.length > 0 && <div class="lead-side">
      <SectionHeading zh="编辑精选" en="Editor’s picks" />
      <StoryList stories={focus} nested compact />
    </div>}
  </section>}
  <section>
    <SectionHeading zh="最新发布" en="Latest articles" variant="major" href="/archive/" />
    <StoryList stories={stories.filter((story) => !picks.includes(story)).slice(0, 9)} nested />
  </section>
</Base>
