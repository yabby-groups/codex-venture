---
import Base from '../layouts/Base.astro';
import BilingualParagraph from '../components/BilingualParagraph.astro';
---
<Base title="联盟推广声明">
  <article class="article">
    <h1 class="page-heading">联盟推广声明<span lang="en">Affiliate disclosure</span></h1>
    <div class="prose">
      <BilingualParagraph zh="使用明确标注的推广链接购买时，本站可能获得佣金。价格、优惠和交易条件以供应商页面为准。"
        en="We may earn a commission when you buy through a clearly marked affiliate link. Check the provider's page for prices, offers and purchase terms." />
      <BilingualParagraph zh="推广关系不决定编辑评价。实测文章会说明实际运行的步骤和结果。"
        en="Affiliate relationships do not determine our editorial evaluations. Hands-on reports describe the steps performed and the observed results." />
    </div>
  </article>
</Base>
