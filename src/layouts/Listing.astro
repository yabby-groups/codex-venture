---
import Base from './Base.astro';
import ListingHeader from '../components/ListingHeader.astro';
import StoryList from '../components/StoryList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { pageSize } from '../lib/listing';
import { dateKey, type Story } from '../lib/content';
interface Props { zh: string; en: string; stories: Story[]; intro?: string[]; page?: number; base?: string; topics?: [string, string[]][]; byDate?: boolean; showStoryDate?: boolean }
const { zh, en, stories, intro, page = 1, base, topics, byDate = false, showStoryDate = true, } = Astro.props;
const lastPage = base ? Math.ceil(stories.length / pageSize) : 1;
const visible = base ? stories.slice((page - 1) * pageSize, page * pageSize) : stories;
const dates = byDate ? [...new Set(visible.map(({ data }) => dateKey(data.published)))] : [];
const url = (index: number) => index === 1 ? base : `${base}page/${index}/`;
---
<Base title={page > 1 ? `${zh} · ${page}` : zh} description={intro?.join(' ') ?? zh + ' · ' + en}>
  <ListingHeader {zh} {en} {intro}>
    <span class="listing-count">{stories.length} 篇 / <span lang="en">{stories.length === 1 ? 'article' : 'articles'}</span></span>
  </ListingHeader>
  {!!topics?.length && <nav class="tag-list" aria-label="内容栏目 / Topics">
    {topics.map(([key, [zh, en]]) => <a href={`/topics/${key}/`}>{zh} · <span lang="en">{en}</span></a>)}
  </nav>}
  <div class:list={['listing-body', { 'reading-grid': dates.length > 0 }]}>
    <div>
      <StoryList stories={visible} showDate={showStoryDate} />
      {lastPage > 1 && <nav class="pagination" aria-label="分页 / Pagination">
        {page > 1 && <a href={url(page - 1)}>← 上一页 / <span lang="en">Previous</span></a>}
        <span>{page} / {lastPage}</span>
        {page < lastPage && <a href={url(page + 1)}>下一页 / <span lang="en">Next</span> →</a>}
      </nav>}
    </div>
    {dates.length > 0 && <aside class="rail">
      <SectionHeading zh="日期归档" en="By date" variant="subtle" href="/archive/" />
      <ul class="archive-list">{dates.map((date) => <li><a href={`/archive/${date}/`}><time datetime={date}>{date}</time><span aria-hidden="true">↗</span></a></li>)}</ul>
    </aside>}
  </div>
</Base>
