---
import Base from './Base.astro';
import ListingHeader from '../components/ListingHeader.astro';
import ResourceCard from '../components/ResourceCard.astro';
import '../styles/resources.css';
import { directoryCopy, directoryTitle, resourceBase, resourcePage, resourcePageSize, type Resource } from '../lib/resources';
import type { ResourceType } from '../lib/resource-schema';
import { jsonLd, resourceEntitySchema } from '../lib/entities';
interface Props { type: ResourceType; rows: Resource[]; page?: number }
const { type, rows, page = 1 } = Astro.props;
const [zh, en] = directoryTitle(type);
const intro = directoryCopy[type];
const base = resourceBase(type);
const lastPage = Math.ceil(rows.length / resourcePageSize);
const visible = rows.slice((page - 1) * resourcePageSize, page * resourcePageSize);
const verified = rows.map((row) => row.verified).sort().at(-1);
const platforms = [...new Set(rows.flatMap((row) => row.platforms))].sort();
const facets = [
  { key: 'category', label: '功能分类 / Category', values: rows.flatMap((row) => row.categories.map(([zh, en]) => [en, zh + ' / ' + en])) },
  ...([
    ['tag', '标签 / Tag', rows.flatMap((row) => row.tags)],
    ['license', '许可证 / License', rows.flatMap((row) => row.license ?? [])],
    ['install', '安装方式 / Installation', rows.flatMap((row) => row.install ?? [])],
    ['transport', '传输方式 / Transport', rows.flatMap((row) => row.transport ?? [])],
  ] as const).map(([key, label, values]) => ({ key, label, values: values.map((value) => [value, value]) })),
].map(({ values, ...facet }) => ({ ...facet, options: [...new Map(values.map(([key, label]) => [key, label])).entries()].sort() }));
const hub = type === 'prompts' || type === 'workflows' ? ['/learn/', '实践', 'Learn'] : ['/discover/', '发现', 'Discover'];
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', url: Astro.url.href,
  name: zh + ' · ' + en, inLanguage: ['zh-CN', 'en'], dateModified: verified,
  mainEntity: { '@type': 'ItemList', numberOfItems: rows.length, itemListElement: visible.map((row, index) => ({
    '@type': 'ListItem', position: (page - 1) * resourcePageSize + index + 1,
    item: resourceEntitySchema(row, Astro.site),
  })) } };
---
<Base title={page === 1 ? zh : zh + ' · ' + page} description={intro.join(' ')}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(schema)} />
  <section class="resource-directory" data-directory={base} data-size={resourcePageSize} data-static-page={page} data-pagefind-body>
    <a class="resource-parent" href={hub[0]}><span aria-hidden="true">←</span> {hub[1]} <span lang="en">{hub[2]}</span></a>
    <ListingHeader {zh} {en}>
      <span class="listing-count" role="status" data-pagefind-ignore><span data-result-count>{rows.length}</span> 项 / <span lang="en">resources</span></span>
    </ListingHeader>
    <div data-enhanced hidden data-pagefind-ignore>
      <div class="resource-controls">
        <label class="resource-search" for="q">
          <span>搜索{type === 'skills' ? '技能' : '资源'} / <span lang="en">Search {type === 'skills' ? 'skills' : 'resources'}</span></span>
          <input id="q" type="search" placeholder="名称、用途、平台 / Name, task, platform" autocomplete="off" />
        </label>
        <label class="resource-sort">
          <span>排序 / <span lang="en">Sort</span></span>
          <select data-sort>
            <option value="">最近收录 / Recently added</option>
            <option value="verified">最近核实 / Recently verified</option>
            <option value="name">名称 / Name</option>
            {rows.filter((row) => row.github).length > 1 && <option value="stars">GitHub Stars</option>}
            {rows.some((row) => row.featured) && <option value="featured">编辑精选 / Editor’s picks</option>}
            {rows.filter((row) => row.releasedAt).length > 1 && <option value="release">版本日期 / Release date</option>}
          </select>
        </label>
      </div>
      {platforms.length > 0 && <div class="resource-platforms" role="group" aria-label="平台 / Platforms">
        <button type="button" data-platform="" aria-pressed="true">全部 / <span lang="en">All</span></button>
        {platforms.map((platform) => <button type="button" data-platform={platform} aria-pressed="false">{platform}</button>)}
      </div>}
    </div>
    <div class="resource-body">
      <details class="resource-filters" data-enhanced hidden data-pagefind-ignore>
        <summary>筛选 / <span lang="en">Filters</span></summary>
        {facets.filter(({ key, options }) => key === 'category' || options.length > 1).map(({ key, label, options }) =>
          <label>{label}<select data-facet={key}><option value="">全部 / All</option>
            {options.map(([value, label]) => <option value={value}>{label}</option>)}
          </select></label>
        )}
        <button type="button" data-clear data-page-action>清除筛选 / <span lang="en">Clear</span></button>
      </details>
      <section aria-label="资源结果 / Resource results">
        <p class="resource-error" data-result-error role="status" data-pagefind-ignore></p>
        <div class="resource-grid" data-cards>{visible.map((resource) => <ResourceCard {resource} />)}</div>
        <p class="resource-empty" data-empty hidden>没有匹配资源。请调整关键词或清除筛选。<span lang="en">No matching resources. Try another search or clear your filters.</span></p>
        <nav class="pagination" data-client-pages hidden aria-label="分页 / Pagination" data-pagefind-ignore>
          <button type="button" data-page-action="-1">← 上一页 / <span lang="en">Previous</span></button>
          <span data-page-count></span>
          <button type="button" data-page-action="1">下一页 / <span lang="en">Next</span> →</button>
        </nav>
        {lastPage > 1 && <nav class="pagination" data-static-pages aria-label="分页 / Pagination">
          {page > 1 && <a href={resourcePage(type, page - 1)}>← 上一页 / <span lang="en">Previous</span></a>}
          <span>{page} / {lastPage}</span>
          {page < lastPage && <a href={resourcePage(type, page + 1)}>下一页 / <span lang="en">Next</span> →</a>}
        </nav>}
      </section>
    </div>
  </section>
</Base>
<script>
  import { enhanceDirectory } from '../lib/directory-client';
  const root = document.querySelector<HTMLElement>('[data-directory]');
  if (root) enhanceDirectory(root);
</script>
