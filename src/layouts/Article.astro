---
import { render } from 'astro:content';
import Repository from '../components/Repository.astro';
import { repositoryFor } from '../lib/repositories';
import Base from './Base.astro';
import { allStories, dateKey, isWeekly, storySection, storyUrl, type Story } from '../lib/content';
interface Props { story: Story }
const { story } = Astro.props;
const { Content } = await render(story);
const stories = await allStories();
const sameType = stories.filter((item) => item.collection === story.collection && isWeekly(item) === isWeekly(story));
const index = sameType.findIndex((item) => item.id === story.id);
const related = stories.filter((item) => storyUrl(item) !== storyUrl(story) && (
  item.data.sources.some((source) => story.data.sources.some((original) => source.url === original.url)) ||
  item.data.tags.some((tag) => story.data.tags.includes(tag))
)).slice(0, 3);
const { data } = story;
const canonical = new URL(storyUrl(story), Astro.site).href;
const { label, href } = storySection(story);
const repo = repositoryFor(story);
const bodyText = (story.body ?? '').replace(/<[^>]+>/g, '').replace(/https?:\/\/\S+/g, '');
const chinese = bodyText.match(/\p{Script=Han}/gu)?.length ?? 0;
const english = bodyText.match(/\b[A-Za-z]+\b/g)?.length ?? 0;
const minutes = Math.max(1, Math.ceil(chinese / 350 + english / 220));
const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Codex Venture', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: label[0], item: new URL(href, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.titleZh, item: canonical },
  ],
}).replaceAll('<', '\\u003c');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': data.type && !['news', 'models'].includes(data.type) ? 'Article' : 'NewsArticle',
  headline: data.titleZh, alternativeHeadline: data.titleEn, datePublished: data.published.toISOString(),
  dateModified: data.verified,
  description: data.summaryZh, mainEntityOfPage: canonical, inLanguage: ['zh-CN', 'en'],
  citation: data.sources.map(({ url }) => url), author: { '@type': 'Organization', name: 'Codex Venture' },
  publisher: { '@type': 'Organization', name: 'Codex Venture', url: Astro.site?.href },
}).replaceAll('<', '\\u003c');
---
<Base title={data.titleZh} description={data.summaryZh + ' ' + data.summaryEn} article>
  <Fragment slot="head"><script type="application/ld+json" set:html={jsonLd} /><script type="application/ld+json" set:html={breadcrumb} /><meta property="article:published_time" content={data.published.toISOString()} /></Fragment>
  <article class="article" data-pagefind-body>
    <nav class="breadcrumbs" aria-label="面包屑 / Breadcrumb">
      <ol><li><a href="/">首页<span lang="en">Home</span></a></li><li aria-hidden="true">/</li><li><a href={href}>{label[0]}<span lang="en">{label[1]}</span></a></li></ol>
    </nav>
    <h1 data-pagefind-meta={`title:${data.titleZh}`}>{data.titleZh}<span lang="en" data-pagefind-meta={`titleEn:${data.titleEn}`}>{data.titleEn}</span></h1>
    <div class="article-byline" data-pagefind-ignore>
      <div>Codex Venture 编辑部 · <time datetime={data.published.toISOString()}>{dateKey(data.published)} · UTC+8</time> · 约 {minutes} 分钟</div>
      <span lang="en">Codex Venture editorial · {minutes} min read</span>
    </div>
    <meta data-pagefind-meta={`section:${label[0]}`} />
    <meta data-pagefind-meta={`sectionEn:${label[1]}`} />
    <meta data-pagefind-meta={`date:${dateKey(data.published)}`} />
    <p class="article-summary">{data.summaryZh}<span lang="en">{data.summaryEn}</span></p>
    {repo && <Repository {repo} {story} detail />}
    <nav class="article-toc" aria-label="目录 / Contents" data-pagefind-ignore hidden>
      <strong>目录 <span lang="en">Contents</span></strong><ol></ol>
    </nav>
    {data.verified && <div class="article-byline">
      <div>核实日期 {data.verified} · {data.version} · {data.tested ? '已验证操作' : '依据资料整理'}
        {data.status !== 'current' && (data.status === 'archived' ? ' · 已归档' : ' · 待复查')}</div>
      <span lang="en">Verified {data.verified} · {data.version} · {data.tested ? 'Procedure checked' : 'Documentation-based'}
        {data.status !== 'current' && (data.status === 'archived' ? ' · Archived' : ' · Needs review')}</span>
    </div>}
    <div class="prose"><Content /></div>
    {data.type === 'prompts' && <button type="button" id="copy-prompt" hidden>复制提示词 / Copy prompt</button>}
    {data.type === 'prompts' && <span id="copy-status" role="status"></span>}
    <section class="article-links" data-pagefind-ignore>
      <h2>原始来源 <span lang="en">Primary Sources</span></h2>
      <ul>{data.sources.map(({ url, title }) => <li><a href={url} lang="en">{title} ↗</a></li>)}</ul>
      <div class="tag-list">{data.tags.map((tag) => <a href={`/tags/${tag}/`}>#{tag}</a>)}</div>
    </section>
  </article>
  <aside class="article article-links" aria-label="更多资讯">
    {related.length > 0 && <><h2>相关资讯 <span lang="en">Related Stories</span></h2><ul>{related.map((item) => <li><a href={storyUrl(item)}>{item.data.titleZh}<span lang="en">{item.data.titleEn}</span></a></li>)}</ul></>}
    <a href={href}>返回{label[0]} <span lang="en">Back to {label[1]}</span></a>
    <nav class="adjacent" aria-label="上一篇和下一篇">
      {sameType[index + 1] && <a href={storyUrl(sameType[index + 1])}>← 较早 · Older<span>{sameType[index + 1].data.titleZh}</span></a>}
      {sameType[index - 1] && <a href={storyUrl(sameType[index - 1])}>较新 · Newer →<span>{sameType[index - 1].data.titleZh}</span></a>}
    </nav>
  </aside>
</Base>

<script>
  const copy = document.querySelector<HTMLButtonElement>('#copy-prompt');
  const prompt = document.querySelector<HTMLElement>('.prose code');
  const status = document.querySelector<HTMLElement>('#copy-status');
  if (copy && prompt && status && navigator.clipboard) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt.textContent ?? '');
        status.textContent = '已复制 / Copied';
      } catch {
        status.textContent = '复制失败，请选择文本 / Copy failed, select the text manually';
      }
    });
  }
  const toc = document.querySelector<HTMLElement>('.article-toc');
  const headings = [...document.querySelectorAll<HTMLElement>('article .prose h2')];
  if (toc && headings.length >= 4) {
    const list = toc.querySelector('ol')!;
    headings.forEach((heading, index) => {
      heading.id ||= `section-${index + 1}`;
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = '#' + heading.id;
      const parts = heading.querySelectorAll<HTMLElement>(':scope > [lang]');
      if (parts.length) parts.forEach((part) => {
        const span = document.createElement('span');
        span.lang = part.lang;
        span.textContent = part.textContent;
        link.append(span);
      });
      else link.textContent = heading.textContent;
      item.append(link);
      list.append(item);
    });
    toc.hidden = false;
  }
</script>
