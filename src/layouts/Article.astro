---
import { render } from 'astro:content';
import '../styles/article.css';
import ArticleHeader from '../components/ArticleHeader.astro';
import ArticleTOC from '../components/ArticleTOC.astro';
import ArticleBlocks from '../components/ArticleBlocks.astro';
import ArticleFooter from '../components/ArticleFooter.astro';
import BilingualParagraph from '../components/BilingualParagraph.astro';
import { articleHeadings } from '../lib/article-headings.mjs';
import Repository from '../components/Repository.astro';
import { repositoryFor } from '../lib/repositories';
import Base from './Base.astro';
import { allStories, dateKey, storySection, storyUrl, types, hubs, isWeekly, type Story } from '../lib/content';
interface Props { story: Story }
const { story } = Astro.props;
const { Content } = await render(story);
const stories = await allStories();
const { data } = story;
const blocks = data.blocks ?? [];
const sections = [
  ...articleHeadings(story.body ?? ''),
  ...blocks.map(({ title }, index) => ({ id: `article-block-${index + 1}`, ...title })),
];
const short = story.collection === 'news' && (!data.type || ['news', 'models'].includes(data.type)) &&
  (story.body?.length ?? 0) < 2400 && !blocks.length;
const showContents = !short && sections.length >= 3;
const related = stories
  .filter((item) => storyUrl(item) !== storyUrl(story) && item.collection === 'news')
  .map((item) => ({
    item,
    score: (item.data.project && item.data.project === data.project ? 8 : 0)
      + (item.data.sources.some((source) => data.sources.some((original) => source.url === original.url)) ? 5 : 0)
      + new Set(item.data.tags.filter((tag) => data.tags.includes(tag))).size,
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, short ? 2 : 3)
  .map(({ item }) => item);
const canonical = new URL(storyUrl(story), Astro.site).href;
const { label, href } = storySection(story);
const parent = story.collection === 'daily'
  ? isWeekly(story) ? 'weekly' : 'daily'
  : data.type ? types[data.type][2] : 'news';
const articleNav = `/${parent}/`;
const parentLabel = parent in hubs ? hubs[parent as keyof typeof hubs] : ['最新资讯', 'Latest'];
const crumbs = [
  { href: '/', label: ['首页', 'Home'] },
  ...(story.collection === 'news' ? [{ href: articleNav, label: parentLabel }] : []),
  { href, label },
];
const repo = repositoryFor(story);
const bodyText = ((story.body ?? '') + ' ' + JSON.stringify(blocks)).replace(/<[^>]+>/g, '').replace(/https?:\/\/\S+/g, '');
const chinese = bodyText.match(/\p{Script=Han}/gu)?.length ?? 0;
const english = bodyText.match(/\b[A-Za-z]+\b/g)?.length ?? 0;
const minutes = Math.max(1, Math.ceil(chinese / 350 + english / 220));
const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    ...crumbs.map((crumb, index) => ({
      '@type': 'ListItem', position: index + 1, name: crumb.label[0], item: new URL(crumb.href, Astro.site).href,
    })),
    { '@type': 'ListItem', position: crumbs.length + 1, name: data.titleZh, item: canonical },
  ],
}).replaceAll('<', '\\u003c');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': data.type && !['news', 'models'].includes(data.type) ? 'Article' : 'NewsArticle',
  headline: data.titleZh, alternativeHeadline: data.titleEn, datePublished: data.published.toISOString(),
  dateModified: data.updated ?? data.published.toISOString(),
  description: data.summaryZh, mainEntityOfPage: canonical, inLanguage: ['zh-CN', 'en'],
  citation: data.sources.map(({ url }) => url), author: { '@type': 'Organization', name: 'Codex Venture' },
  publisher: { '@type': 'Organization', name: 'Codex Venture', url: Astro.site?.href },
}).replaceAll('<', '\\u003c');
---
<Base title={data.titleZh} description={data.summaryZh + ' ' + data.summaryEn} article {articleNav}>
  <Fragment slot="head"><script type="application/ld+json" set:html={jsonLd} /><script type="application/ld+json" set:html={breadcrumb} /><meta property="article:published_time" content={data.published.toISOString()} /></Fragment>
  <article class:list={['editorial-article', { 'article-short': short, 'article-with-rail': showContents }]} data-pagefind-body>
    <ArticleHeader {data} {crumbs} {minutes} />
    <meta data-pagefind-meta={`section:${label[0]}`} />
    <meta data-pagefind-meta={`sectionEn:${label[1]}`} />
    <meta data-pagefind-meta={`date:${dateKey(data.published)}`} />
    <div class="article-grid">
      {showContents && <ArticleTOC {sections} />}
      <div class="article-content">
        {data.status && data.status !== 'current' && <BilingualParagraph class="article-notice" zh={data.status === 'archived' ? '此文已归档，操作和版本信息可能过时。' : '此文等待复查，使用前请核对当前文档。'} en={data.status === 'archived' ? 'Archived. Instructions and version information may be outdated.' : 'Pending review. Check current documentation before use.'} />}
        {data.tested === false && data.type && ['skills', 'plugins', 'mcp', 'tutorials', 'workflows', 'comparisons'].includes(data.type) &&
          <BilingualParagraph class="article-notice" zh="依据公开资料整理，操作未经本站实测。" en="Based on public documentation. The editorial team did not run the procedure." />}
        <div class="prose"><Content /></div>
        <ArticleBlocks {blocks} />
        {repo && <Repository {repo} {story} detail />}
        <ArticleFooter {data} {related} {label} {href} />
      </div>
    </div>
  </article>
</Base>
