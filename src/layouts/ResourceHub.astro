---
import Base from './Base.astro';
import ListingHeader from '../components/ListingHeader.astro';
import ResourceCard from '../components/ResourceCard.astro';
import StoryList from '../components/StoryList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { directoryTitle, resourceBase, resourceDate, resourceDirectories, resourceInLearn } from '../lib/resources';
import type { Story } from '../lib/content';
import { sections, types, topicLink } from '../lib/navigation';
import ResourceSearch from '../components/ResourceSearch.astro';
import '../styles/resources.css';

const { hub, stories } = Astro.props as { hub: 'discover' | 'learn'; stories: Story[] };
const [zh, en] = sections[hub].label;
const learning = hub === 'learn';
const intro = learning
  ? ['按任务查找教程、工作流、提示词与工具对比。', 'Find tutorials, workflows, prompts and comparisons for the task at hand.']
  : ['探索 AI 技能、插件、模型和工具，快速找到官方资料与实践指南。', 'Explore AI skills, extensions, models and tools with links to official references and practical guides.'];
const directories = resourceDirectories(stories).filter(({ type }) => !learning || resourceInLearn(type));
const resources = directories.flatMap(({ rows }) => rows);
const featured = learning ? resources.filter((row) => row.featured).slice(0, 3) : [];
const recent = [...resources].sort((a, b) => b.added.localeCompare(a.added) || a.id.localeCompare(b.id)).slice(0, 3);
const updated = learning ? [] : resources
  .filter((row) => row.updatedAt && row.updatedAt > row.added)
  .sort((a, b) => resourceDate(b).localeCompare(resourceDate(a)) || a.id.localeCompare(b.id))
  .slice(0, 3);
const articleTopics = Object.entries(types).filter(([key, [, , owner]]) =>
  owner === hub && stories.some(({ data }) => data.type === key));
const editorialTopics = articleTopics.filter(([key]) => !directories.some(({ type }) => type === key));
---
<Base title={zh} description={intro.join(' ')}>
  <div class="resource-directory" data-pagefind-body>
    <ListingHeader {zh} {en} {intro}>
      {!learning && <span class="listing-count">{resources.length} 项 / <span lang="en">resources</span></span>}
    </ListingHeader>
    {!learning && resources.length > 0 && <ResourceSearch {directories} />}
    <nav class="resource-directory-links" aria-label="栏目入口 / Browse sections">
      {directories.map(({ type, rows }) => {
        const [zh, en] = directoryTitle(type);
        return <a href={resourceBase(type)}><strong>{zh}</strong><span lang="en">{en}</span><span>{rows.length} 项 / <span lang="en">{rows.length === 1 ? 'resource' : 'resources'}</span></span></a>;
      })}
      {learning && editorialTopics.map(([key, [zh, en]]) => <a href={topicLink(key as keyof typeof types).href}><strong>{zh}</strong><span lang="en">{en}</span></a>)}
    </nav>
    {featured.length > 0 && <section class="resource-hub-section">
      <SectionHeading zh="编辑精选" en="Editor’s picks" />
      <div class="resource-grid">{featured.map((resource) => <ResourceCard {resource} />)}</div>
    </section>}
    {recent.length > 0 && <section class="resource-hub-section">
      <SectionHeading zh={learning ? '可复用的实践' : '最新收录'} en={learning ? 'Ready to reuse' : 'Recently added'} />
      <div class="resource-grid">{recent.map((resource) => <ResourceCard {resource} />)}</div>
    </section>}
    {!learning && <section class="resource-hub-section">
      <SectionHeading zh="最近更新" en="Recently updated" />
      {updated.length ? <div class="resource-grid">{updated.map((resource) => <ResourceCard {resource} />)}</div> :
        <p>暂无更新记录。 <span lang="en">No updates recorded yet.</span></p>}
    </section>}
    {!learning && !resources.length && <p>暂无收录资源。 <span lang="en">No resources have been added yet.</span></p>}
    {learning && articleTopics.map(([key, [zh, en]]) => <section class="resource-hub-section">
      <SectionHeading {zh} {en} href={topicLink(key as keyof typeof types).href} />
      <StoryList stories={stories.filter(({ data }) => data.type === key).slice(0, 4)} nested />
    </section>)}
  </div>
</Base>
