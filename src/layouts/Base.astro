---
import '../styles/site.css';
import AnalyticsChoice from '../components/AnalyticsChoice.astro';
import NavLabel from '../components/NavLabel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { jsonLd, organization } from '../lib/entities';
import { rss, sections, technologyIndex, technologyLink, technologyLinks, topicSection, types, type TechnologyCategory } from '../lib/navigation';
const { title = '全球 AI 资讯', description = '每日追踪全球 AI 模型、工具和产品更新。 Daily coverage of AI models, tools and product updates.', article = false, noindex = false, articleNav, articleCategory, ads = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const mode = import.meta.env.VENTURE_WEB_ANALYTICS_MODE || 'manual';
const beaconToken = import.meta.env.CLOUDFLARE_WEB_ANALYTICS_SITE_TAG || '90f572bbf72d4f6bb3ef71bfdc6a4ab3';
if (!['automatic', 'manual', 'disabled'].includes(mode) ||
    (mode === 'manual' && !/^[a-zA-Z0-9_-]{16,64}$/.test(beaconToken || ''))) {
  throw new Error('Invalid Cloudflare Web Analytics build configuration');
}
const pageTitle = title + ' · Codex Venture';
const pathname = Astro.url.pathname;
const [, route, key] = pathname.split('/');
const topic = route === 'topics' && Object.hasOwn(types, key) ? topicSection(key as keyof typeof types) : undefined;
const activeNav = articleNav ?? topic?.href ?? pathname;
const activeTechnology = articleCategory ? technologyLink(articleCategory as TechnologyCategory).href : pathname;
const current = (href: string, active = activeNav) => {
  if (pathname === href) return 'page';
  if (href !== '/' && active.startsWith(href)) return 'location';
};

---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Codex Venture" href={rss.href} />
  <meta property="og:site_name" content="Codex Venture" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {mode === 'manual' && <script is:inline define:vars={{ beaconToken }}>
    document.addEventListener('DOMContentLoaded', () => {
      const src = 'https://static.cloudflareinsights.com/beacon.min.js';
      if (location.origin !== 'https://codex-venture.com' || navigator.webdriver ||
          /HeadlessChrome|Codex-Venture-Test/i.test(navigator.userAgent) ||
          document.querySelector('script[src^="' + src + '"]')) return;
      const beacon = document.createElement('script');
      beacon.src = src;
      beacon.dataset.cfBeacon = JSON.stringify({ token: beaconToken });
      document.head.append(beacon);
    }, { once: true });
  </script>}
  {noindex && <meta name="robots" content="noindex,follow" />}
  <script is:inline>
    try {
      const saved = localStorage.getItem('venture-theme');
      if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
    } catch {}
  </script>
  {pathname === '/' && <script type="application/ld+json" set:html={jsonLd({
    '@context': 'https://schema.org',
    '@graph': [organization(Astro.site), { '@type': 'WebSite', name: 'Codex Venture',
      url: canonical.href, inLanguage: ['zh-CN', 'en'], publisher: { '@id': new URL('/#organization', Astro.site).href } }],
  })} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">跳至正文 / Skip to content</a>
  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href={sections.home.href} aria-label="Codex Venture 首页 / Home"><img src="/favicon.svg" width="38" height="38" alt="" /><span lang="en">Codex Venture</span></a>
      <div class="utilities">
        <a href="/search/" aria-current={current('/search/')} class="utility" aria-label="搜索 / Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 4 4"/></svg><span>搜索 <small lang="en">Search</small></span></a>
        <button id="theme" class="utility" type="button" aria-label="深色主题 / Dark theme" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15a8 8 0 0 1-11-11 8 8 0 1 0 11 11Z"/></svg></button>
        <a class="utility rss" href={rss.href} aria-label="RSS">RSS</a>
      </div>
    </div>
    <nav class="masthead-nav" aria-label="内容 / Content">
      <ul class="wrap masthead-links">
        {Object.values(sections).map(({ href, label }) => <li><a href={href} aria-current={current(href)}><NavLabel {label} /></a></li>)}
      </ul>
    </nav>
    <nav class="masthead-nav masthead-topics" aria-label="技术分类 / Technology categories">
      <ul class="wrap masthead-links">
        {[...technologyLinks, technologyIndex].map(({ href, label }) => <li><a href={href} aria-current={current(href, activeTechnology)}><NavLabel {label} /></a></li>)}
      </ul>
    </nav>
  </header>
  <AnalyticsChoice />
  <main id="main" class="wrap"><slot /></main>
  <SiteFooter {ads} />
  <script>
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        const input = document.querySelector<HTMLInputElement>('#q');
        if (input) input.focus();
        else location.assign('/search/');
      }
      if (event.key === 'Escape' && event.target instanceof Element) {
        const disclosure = event.target.closest<HTMLDetailsElement>('details[open]');
        if (disclosure) {
          disclosure.open = false;
          disclosure.querySelector('summary')?.focus();
        }
      }
    });
    for (const links of document.querySelectorAll<HTMLElement>('.masthead-links')) {
      const active = links.querySelector<HTMLElement>('[aria-current]');
      if (active && active.getBoundingClientRect().right > links.getBoundingClientRect().right) {
        links.scrollLeft = active.getBoundingClientRect().left - links.getBoundingClientRect().left;
      }
    }
    const button = document.querySelector<HTMLButtonElement>('#theme')!;
    const scheme = matchMedia('(prefers-color-scheme: dark)');
    const dark = () => (document.documentElement.dataset.theme ?? (scheme.matches ? 'dark' : 'light')) === 'dark';
    const sync = () => button.setAttribute('aria-pressed', String(dark()));
    button.hidden = false;
    sync();
    scheme.addEventListener('change', sync);
    button.addEventListener('click', () => {
      const theme = dark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('venture-theme', theme); } catch {}
      sync();
    });
  </script>
</body>
</html>
