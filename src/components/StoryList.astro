---
import { dateKey, storySection, storyUrl, type Story } from '../lib/content';
interface Props { stories: Story[]; nested?: boolean; compact?: boolean }
const { stories, nested = false, compact = false } = Astro.props;
const Heading = nested ? 'h3' : 'h2';
---
{stories.length ? <ul class:list={['story-list', { compact }]}>
  {stories.map((story) => {
    const section = storySection(story);
    return <li>
      <div class="story-meta">
        <a href={section.href}>{section.label[0]}<span lang="en">{section.label[1]}</span></a>
        <time datetime={story.data.published.toISOString()}>{dateKey(story.data.published)}</time>
      </div>
      <Heading><a href={storyUrl(story)}>{story.data.titleZh}<span lang="en">{story.data.titleEn}</span></a></Heading>
      {!compact && <><p>{story.data.summaryZh}<span lang="en">{story.data.summaryEn}</span></p>
        <div class="source-line"><span>来源 / Source </span><a href={story.data.sources[0].url}>{new URL(story.data.sources[0].url).hostname}</a></div></>}
    </li>;
  })}
</ul> : <p class="empty">暂无已发布资讯。<span lang="en">No stories published yet.</span></p>}
