---
interface Props {
  zh: string;
  en: string;
  href?: string;
  level?: 2 | 3 | 4;
  variant?: 'major' | 'compact' | 'subtle';
}
const { zh, en, href, level = 2, variant = 'compact' } = Astro.props;
const Heading = `h${level}` as const;
---
<div class:list={['section-heading', `section-heading--${variant}`]}>
  <Heading>{zh}<span lang="en">{en}</span></Heading>
  {href && <a href={href}>查看全部 <span lang="en">View all</span><span aria-hidden="true"> ↗</span><span class="sr-only"> {zh} <span lang="en">{en}</span></span></a>}
</div>
