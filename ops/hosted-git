#!/usr/bin/env bash
set -euo pipefail
: "${VENTURE_GIT_TOKEN:?Missing GitHub credential}"
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=http.https://github.com/.extraheader
GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$VENTURE_GIT_TOKEN" | base64 -w0)"
export GIT_CONFIG_VALUE_0
unset VENTURE_GIT_TOKEN
exec "$@"
